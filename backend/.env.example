# Copy to backend/.env and fill in your local MySQL credentials.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=student_record_system

SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development

# 48-hour HTTP-only JWT sessions (PRJ-SR-003) and bcrypt work factor (PRJ-SR-002)
JWT_EXPIRY_HOURS=48
BCRYPT_ROUNDS=12

# Set true behind TLS 1.3 (see README: "HTTPS / TLS 1.3"). Redirects HTTP->HTTPS, adds HSTS, secure cookies.
ENFORCE_HTTPS=false

# Login throttling (requests per minute per IP). 0 disables.
LOGIN_RATE_LIMIT_PER_MIN=30
