# Copy to backend/.env (never commit .env). Placeholders only - no real secrets.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost/student_records

# DEV ONLY (US-06). Until login/token validation exists, the enrollment
# endpoints answer 401 unless this is "true"; then the X-Student-Id header
# identifies the caller, which ANYONE can forge. Never enable on a server.
ALLOW_INSECURE_DEV_IDENTITY=false
